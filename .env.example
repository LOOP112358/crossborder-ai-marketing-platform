# ===== 本地 ABO 知识库 =====
ABO_LISTINGS_DIR=C:\Users\lishu\Downloads\abo-listings
ABO_IMAGES_DIR=C:\Users\lishu\Downloads\abo-images-small
ABO_IMPORT_LIMIT=3000

# ===== 大模型 API（DeepSeek / OpenAI 兼容）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 文案模块兼容字段（可与上面共用同一把 key）
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# ===== 抠图 =====
# 默认快速白底抠图（ABO 够用）。需要 AI 精细抠图再设：MATTE_USE_REMBG=1
# MATTE_USE_REMBG=0
# MATTE_SKIP_OLLAMA=1

# ===== 背景生成（成员3 双模型）=====
# BG_MOCK_MODE=1 强制占位图；=0 且配置了 Key 则调真实 API
BG_MOCK_MODE=0
# BG_USE_SD=0 默认只用豆包 Seedream；=1 才同时调 Stability（耗额度）
BG_USE_SD=0
# 豆包 Seedream（火山方舟）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seedream-5-0-pro-260628

# Stable Diffusion（Stability AI，可选；额度不足时保持 BG_USE_SD=0）
STABILITY_API_KEY=
STABILITY_MODEL=sd3.5-medium
STABILITY_OUTPUT_FORMAT=png

# ===== JWT / 数据库 =====
SECRET_KEY=dev-secret-change-me
DATABASE_URL=sqlite:///./data/module1.db
