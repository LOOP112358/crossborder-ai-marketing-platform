# ===== 本地 ABO 知识库 =====
ABO_LISTINGS_DIR=C:\Users\lishu\Downloads\abo-listings
ABO_IMAGES_DIR=C:\Users\lishu\Downloads\abo-images-small
ABO_IMPORT_LIMIT=3000

# ===== 大模型 API（DeepSeek / OpenAI 兼容）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 文案模块兼容字段
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# ===== 抠图 =====
# 默认快速白底抠图。需要 AI 精细抠图再设：MATTE_USE_REMBG=1
# MATTE_USE_REMBG=0
# MATTE_SKIP_OLLAMA=1

# ===== 背景生成（豆包 Seedream）=====
# BG_MOCK_MODE=1 强制占位图；=0 且配置了 Key 则调真实 API
BG_MOCK_MODE=0
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 推荐 lite（更快更便宜）；未在控制台开通时会自动回退 FALLBACK
ARK_MODEL=doubao-seedream-5-0-lite-260128
ARK_MODEL_FALLBACK=doubao-seedream-5-0-pro-260628
# BG_IMAGE_SIZE=1024x1024
BG_API_TIMEOUT=180

# ===== 海报中文字体（Linux 云服务器）=====
# 未设置时会自动查找 Noto / 文泉驿；也可显式指定：
# POSTER_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
SECRET_KEY=dev-secret-change-me
DATABASE_URL=sqlite:///./data/module1.db
